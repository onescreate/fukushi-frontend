{
  "redirects": [
    { "source": "/", "destination": "/fukushi", "permanent": false }
  ],
  "rewrites": [
    { "source": "/fukushi/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/fukushi/favicon.svg", "destination": "/favicon.svg" },
    { "source": "/fukushi/icon.png", "destination": "/icon.png" },
    { "source": "/fukushi/manifest.json", "destination": "/manifest.json" },
    { "source": "/fukushi", "destination": "/index.html" },
    { "source": "/fukushi/(.*)", "destination": "/index.html" }
  ]
}
