# バックエンドAPIのURL（ローカル開発）
VITE_API_URL=http://localhost:8080

# 会計ポータルのURL（システム切替リンク・タスク/カレンダーの埋め込みに使用）
VITE_PORTAL_URL=https://management.ones-create.net

# 会計ポータルの「バックエンドAPI」URL（不具合報告の送信先）。ポータル側フロントの VITE_API_URL と同じ値を設定する。
VITE_PORTAL_API_URL=https://あなたのポータルバックエンドURL.run.app

# Firebase Web 設定（公開情報）
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
